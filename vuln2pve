#!/usr/bin/env bash

# Defaults
dns=local                       # DNS server for the VM, default is local (Proxmox host).
storage=local-lvm               # Storage location for the VM disk, default is local-lvm.
images_dir=/var/lib/vz/images   # Images directory, default is /var/lib/vz/images.
bridge=vmbr0                    # Bridge for network, default is vmbr0.
cores=2                         # Number of CPU cores for the VM, default is 2.
memory=1024                     # Memory in MB for the VM, default is 1024 (1GB).
keyboard=de                     # Keyboard layout, default is German (de). This can be changed to
                                # your preferred layout (e.g., en-us for US English).
min_vm_id=100                   # Minimum VM ID (inclusive), default is 100.
max_vm_id=0                     # Maximum VM ID (exclusive), default is 0 (no limit).

# Load config file if it exists, allowing users to override defaults without modifying the script.
# Resolves to the invoking user's home when run via sudo, falling back to /root when run directly
# as root. The config file can contain variable assignments to override the defaults above, e.g.:
#     images_dir="/path/to/your/images"
#     bridge="vmbr1"
config_dir="${XDG_CONFIG_HOME:-$(getent passwd "${SUDO_USER:-root}" | cut -d: -f6)/.config}"
config_file="$config_dir/vuln2pve/vuln2pve.conf"
# shellcheck source=/dev/null
[ -f "$config_file" ] && source "$config_file"

# Color codes
NORMAL="\e[0m"
BOLD="\e[1m"
GREEN="\e[1;32m"
RED="\e[1;31m"
COLS=$(tput cols 2>/dev/null || echo 80)

info()    { echo -e "${BOLD}[*]${NORMAL} $*"; }
success() { echo -e "${GREEN}[+]${NORMAL} $*"; }
fail()    { echo -e "${RED}[-]${NORMAL} $*"; }

# Runs a command in the background, animating a Braille spinner inside the
# status bracket. Resolves to [+] done. or [-] failed. on the same line.
# Captured output is printed below on failure for diagnosis.
run_task() {
    local msg=$1; shift
    local frames='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
    local i=0 tmp
    tmp=$(mktemp)
    "$@" > "$tmp" 2>&1 &
    local pid=$!
    while kill -0 "$pid" 2>/dev/null; do
        printf "\r${BOLD}[%s]${NORMAL} %s..." "${frames:$(( i % 10 )):1}" "$msg"
        (( i++ ))
        sleep 0.1
    done
    wait "$pid"
    local exit_code=$?
    if (( exit_code == 0 )); then
        printf "\r${GREEN}[+]${NORMAL} %s..." "$msg"
        print_right "$(( ${#msg} + 7 ))" "$GREEN" "done"
    else
        printf "\r${RED}[-]${NORMAL} %s..." "$msg"
        print_right "$(( ${#msg} + 7 ))" "$RED" "failed"
        cat "$tmp"
    fi
    rm -f "$tmp"
    return "$exit_code"
}

print_right() {
    local prefix_len=$1 color=$2 word=$3
    local pad=$(( COLS - prefix_len - ${#word} ))
    (( pad < 1 )) && pad=1
    printf "%*s${color}%s${NORMAL}\033[K\n" "$pad" "" "$word"
}

draw_bar() {
    local pct=$1 width=40 filled empty bar="" i
    filled=$(( pct * width / 100 ))
    empty=$(( width - filled ))
    for (( i=0; i<filled; i++ )); do bar+="█"; done
    for (( i=0; i<empty; i++ )); do bar+="░"; done
    printf "[%s] %3d%%" "$bar" "$pct"
}

get_qcow_name() {
    echo "$(basename "$1" | cut -d "." -f 1 | sed -e 's/_/-/g' -e 's/ //g').qcow2"
}

usage() {
    echo "Usage: $(basename "$0") [OPTIONS] [URL]"
    echo ""
    echo "  -b, --bridge      Network bridge (default: $bridge)"
    echo "  -c, --cores       CPU cores (default: $cores)"
    echo "  -d, --dns         DNS nameserver (default: $dns)"
    echo "  -i, --images-dir  Images directory (default: $images_dir)"
    echo "  -k, --keyboard    Keyboard layout (default: $keyboard)"
    echo "  -m, --memory      Memory in MB (default: $memory)"
    echo "  -s, --storage     VM disk storage (default: $storage)"
    echo "      --min-id      Minimum VM ID, inclusive (default: $min_vm_id)"
    echo "      --max-id      Maximum VM ID, exclusive, 0 = no limit (default: $max_vm_id)"
    echo "  -h, --help        Show this help"
}

# Parse command-line arguments
url=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        -b|--bridge)      bridge="$2";     shift 2 ;;
        -c|--cores)       cores="$2";      shift 2 ;;
        -d|--dns)         dns="$2";        shift 2 ;;
        -i|--images-dir)  images_dir="$2"; shift 2 ;;
        -k|--keyboard)    keyboard="$2";   shift 2 ;;
        -m|--memory)      memory="$2";     shift 2 ;;
        -s|--storage)     storage="$2";    shift 2 ;;
        --min-id)         min_vm_id="$2";  shift 2 ;;
        --max-id)         max_vm_id="$2";  shift 2 ;;
        -h|--help)        usage; exit 0 ;;
        -*)               fail "Unknown option: $1"; usage; exit 2 ;;
        *)                url="$1"; shift ;;
    esac
done

# Validate VM ID range
if (( max_vm_id != 0 && max_vm_id <= min_vm_id )); then
    fail "--max-id ($max_vm_id) must be greater than --min-id ($min_vm_id)."; exit 2
fi

# Root check
[[ $EUID -ne 0 ]] && { fail "This script must be run as root."; exit 2; }

# Create VM Id
old_vm_id=$( cut -d ":" -f 1 /etc/pve/.vmlist | grep "[0-9]" | tr -d '"' | sort -nr | head -n 1)
vm_id=$(( ${old_vm_id:-0} + 1 ))
(( vm_id < min_vm_id )) && vm_id=$min_vm_id
if (( max_vm_id > 0 && vm_id >= max_vm_id )); then
    fail "No available VM ID in range [$min_vm_id, $max_vm_id)."; exit 2
fi

# Change to image dir
cd "$images_dir" || { fail "Cannot enter $images_dir"; exit 2; }

# 1. Download
if [ -n "$url" ]; then
    download_name=$(basename "$url")
    if ! echo "$download_name" | grep -qE "\.(rar|zip|ova|7z)$"; then
        fail "URL does not point to a .zip, .7z, .rar or .ova file."; exit 2
    fi
    # wget is special-cased: its progress bar is shown below the status line,
    # then cursor-up resolves [*] -> [+] or [-] when the download finishes.
    printf "${BOLD}[*]${NORMAL} Downloading %s...\n" "$download_name"
    wget -q --show-progress "$url" -O "$download_name" 2>&1
    exit_code=$?
    printf "\033[2A\r"
    if (( exit_code == 0 )); then
        printf "${GREEN}[+]${NORMAL} Downloading %s..." "$download_name"
        print_right "$(( ${#download_name} + 19 ))" "$GREEN" "done"
        printf "\n"
    else
        printf "${RED}[-]${NORMAL} Downloading %s..." "$download_name"
        print_right "$(( ${#download_name} + 19 ))" "$RED" "failed"
        printf "\n"; exit 2
    fi
fi

# 2. Extract — entire loop runs as one background task
extract_all() {
    local extracted=1 file
    while [ $extracted -eq 1 ]; do
        extracted=0

        file=$(find "$images_dir"/ -maxdepth 2 -name '*.zip' | head -n 1)
        if [ -n "$file" ]; then
            command -v unzip &>/dev/null || apt install -y unzip
            unzip -q "$file" || return 1
            rm "$file"; extracted=1
        fi

        file=$(find "$images_dir"/ -maxdepth 2 -name '*.7z' | head -n 1)
        if [ -n "$file" ]; then
            command -v p7zip &>/dev/null || apt install -y p7zip
            p7zip -d "$file" || return 1
            extracted=1
        fi

        file=$(find "$images_dir"/ -maxdepth 2 -name '*.rar' | head -n 1)
        if [ -n "$file" ]; then
            command -v unrar &>/dev/null || return 1
            unrar x -inul "$file" || return 1
            rm "$file"; extracted=1
        fi

        file=$(find "$images_dir"/ -maxdepth 2 -name '*.ova' | head -n 1)
        if [ -n "$file" ]; then
            tar -xf "$file" || return 1
            rm "$file"; extracted=1
        fi
    done
}
run_task "Extracting" extract_all || exit 2

# 3. Convert — find the source file in the parent shell so qcow_name is available afterwards
source_file=$(find "$images_dir"/ -maxdepth 2 -name '*.vdi' | head -n 1)
[ -z "$source_file" ] && \
    source_file=$(find "$images_dir"/ -maxdepth 2 -name '*.vmdk' -printf '%s\t%p\n' \
        | sort -n | cut -f2- | head -n 1)

if [ -n "$source_file" ]; then
    qcow_name=$(get_qcow_name "$source_file")
    if [[ "$source_file" == *.vdi ]]; then
        run_task "Converting $(basename "$source_file")" \
            qemu-img convert -f vdi -O qcow2 "$source_file" "$qcow_name" || exit 2
    else
        run_task "Converting $(basename "$source_file")" \
            qemu-img convert -O qcow2 "$source_file" "$qcow_name" || exit 2
        find "$images_dir"/ -maxdepth 2 -name '*.vmdk' -delete
    fi
    rm -f "$source_file"
fi

# Stage qcow2 in VM directory
if [ -n "${qcow_name:-}" ] && [ -f "$qcow_name" ]; then
    mkdir "$vm_id" || { fail "Failed to create staging directory $vm_id"; exit 2; }
else
    fail "No qcow2 image found to import."; exit 2
fi
cp ./*.qcow2 "$vm_id/" || { fail "Failed to copy qcow2 to staging directory."; exit 2; }
rm -f ./*.mf ./*.ovf ./*.qcow2

# 4. Create VM
name=$(find "$images_dir"/"$vm_id"/ -name '*.qcow2' | head -n 1 \
    | rev | cut -d "/" -f 1 | rev | cut -d "." -f 1 \
    | sed 's/-disk-\?[0-9]*$//' | tr '[:upper:]' '[:lower:]' | tr '_' '-')

create_vm() {
    qm create "$vm_id" \
    --net0 e1000,bridge="$bridge" \
    --acpi yes \
    --cores "$cores" \
    --keyboard "$keyboard" \
    --memory "$memory" \
    --name "$name" \
    --nameserver "$dns" \
    --ostype l26 \
    --sockets 1 \
    --onboot yes \
    --kvm yes
}
run_task "Creating VM $vm_id ($name)" create_vm || exit 2

# 5. Import disk — progress bar with spinner inside bracket
disk_path=$(find "$images_dir"/"$vm_id"/ -name '*.qcow2' | head -n 1)
tmp=$(mktemp)
frames='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
i=0
qm importdisk "$vm_id" "$disk_path" "$storage" > "$tmp" 2>&1 &
pid=$!
while kill -0 "$pid" 2>/dev/null; do
    pct=$(grep -oP '\(\K[0-9]+(?=\.[0-9]+%)' "$tmp" 2>/dev/null | tail -1)
    frame="${frames:$(( i % 10 )):1}"
    if [[ -n "$pct" ]]; then
        printf "\r${BOLD}[%s]${NORMAL} Importing disk... %s" "$frame" "$(draw_bar "$pct")"
    else
        printf "\r${BOLD}[%s]${NORMAL} Importing disk..." "$frame"
    fi
    (( i++ ))
    sleep 0.3
done
wait "$pid"
if (( $? == 0 )); then
    printf "\r${GREEN}[+]${NORMAL} Importing disk... %s" "$(draw_bar 100)"
    print_right 69 "$GREEN" "done"
else
    printf "\r${RED}[-]${NORMAL} Importing disk..."
    print_right 22 "$RED" "failed"
    cat "$tmp"; rm -f "$tmp"; exit 2
fi
rm -f "$tmp"
rm -rf "${images_dir:?}/${vm_id:?}"

# 6. Configure VM
configure_vm() {
    local vm_config=/etc/pve/qemu-server/"$vm_id".conf
    sed -i '1s/^/bios: seabios\nbootdisk: ide0\n/' "$vm_config" &&
    sed -i '/boot:/d' "$vm_config" &&
    sed -i 's/^unused/ide/g' "$vm_config"
}
run_task "Configuring VM" configure_vm || exit 2

success "VM $vm_id ($name) is ready."
